{
  "name": "youtube-comment-image",
  "version": "1.0.0",
  "description": "Render a YouTube live-chat comment from any name and text, and export it as a PNG that matches a real screenshot.",
  "private": true,
  "license": "MIT",
  "author": "Daniel Midgley",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "start": "node scripts/electron.js .",
    "test": "node --test \"test/unit/**/*.test.js\" \"test/screenshots/*.test.js\"",
    "test:visual": "node scripts/electron.js test/visual/golden.js",
    "test:screenshots": "node scripts/electron.js test/screenshots/evaluate.js",
    "dist": "electron-builder --win",
    "dist:premiere": "node scripts/package-premiere-plugin.js"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0"
  },
  "build": {
    "appId": "com.danielmidgley.youtube-comment-image",
    "productName": "YouTube Chat Comment",
    "copyright": "Copyright © 2026 Daniel Midgley",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "package.json",
      "!node_modules/tesseract.js/{src,docs,scripts}/**",
      "!node_modules/tesseract.js/dist/{tesseract.min.js,*.map}",
      "!node_modules/tesseract.js-core/*.wasm",
      "!node_modules/tesseract.js-core/tesseract-core{,-simd,-relaxedsimd}{,-lstm}.js",
      "!node_modules/tesseract.js-core/tesseract-core{,-simd,-relaxedsimd}.wasm.js",
      "!node_modules/@tesseract.js-data/eng/4.0.0/**",
      "!node_modules/{bmp-js,idb-keyval,is-url,node-fetch,opencollective-postinstall,regenerator-runtime,tr46,wasm-feature-detect,webidl-conversions,whatwg-url,zlibjs}/**"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "portable": {
      "artifactName": "YouTube-Chat-Comment-${version}-portable.exe"
    },
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    }
  },
  "dependencies": {
    "@tesseract.js-data/eng": "^1.0.0",
    "mediabunny": "^1.61.0",
    "tesseract.js": "^7.0.0"
  }
}
